generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  VIEWER
}

enum ExamStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENTE
  FALTOU
}

model School {
  id         String      @id @default(cuid())
  name       String
  users      User[]
  classrooms Classroom[]
  exams      Exam[]
  createdAt  DateTime    @default(now())
}

model User {
  id                  String              @id @default(cuid())
  schoolId            String
  name                String
  email               String              @unique
  passwordHash        String
  role                UserRole
  active              Boolean             @default(true)
  teacherProfile      TeacherProfile?
  answerKeysUpdated   AnswerKey[]         @relation("AnswerKeyUpdatedBy")
  responsesUpdated    StudentResponse[]   @relation("StudentResponseUpdatedBy")
  assignments         TeacherAssignment[] @relation("TeacherUserAssignments")
  auditLogs           AuditLog[]
  sectionsResponsible ExamSection[]       @relation("SectionTeacherOwner")
  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model TeacherProfile {
  userId String @id
  phone  String?
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Discipline {
  id        String              @id @default(cuid())
  name      String              @unique
  sections  ExamSection[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  assignment TeacherAssignment[]
}

model Classroom {
  id          String              @id @default(cuid())
  schoolId    String
  name        String
  grade       Int
  year        Int
  active      Boolean             @default(true)
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    Student[]
  assignments TeacherAssignment[]
  examLinks   ExamClassroom[]

  @@unique([schoolId, name, year])
}

model Student {
  id                 String            @id @default(cuid())
  fullName           String
  classroomId        String
  registrationNumber String?
  active             Boolean           @default(true)
  classroom          Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attendances        Attendance[]
  responses          StudentResponse[]
}

model Exam {
  id          String         @id @default(cuid())
  title       String
  appliedAt   DateTime
  schoolYear  Int
  schoolId    String
  status      ExamStatus     @default(DRAFT)
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    ExamSection[]
  classrooms  ExamClassroom[]
  attendance  Attendance[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ExamClassroom {
  id          String    @id @default(cuid())
  examId      String
  classroomId String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([examId, classroomId])
}

model ExamSection {
  id             String            @id @default(cuid())
  examId          String
  disciplineId    String
  questionCount   Int
  allowedOptions  Json
  weight          Float?
  teacherOwnerId  String?
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  discipline      Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  teacherOwner    User?            @relation("SectionTeacherOwner", fields: [teacherOwnerId], references: [id], onDelete: SetNull)
  answerKey       AnswerKey?
  responses       StudentResponse[]

  @@unique([examId, disciplineId])
}

model AnswerKey {
  id              String      @id @default(cuid())
  examSectionId   String      @unique
  answers         Json
  updatedByUserId String
  updatedAt       DateTime    @updatedAt
  section         ExamSection @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  updatedBy       User        @relation("AnswerKeyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
}

model Attendance {
  id        String           @id @default(cuid())
  examId    String
  studentId String
  status    AttendanceStatus @default(PRESENTE)
  exam      Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model StudentResponse {
  id              String      @id @default(cuid())
  examSectionId   String
  studentId       String
  answers         Json
  updatedByUserId String
  updatedAt       DateTime    @updatedAt
  examSection     ExamSection @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy       User        @relation("StudentResponseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([examSectionId, studentId])
}

model TeacherAssignment {
  id            String     @id @default(cuid())
  teacherUserId String
  classroomId   String
  disciplineId  String
  teacher       User       @relation("TeacherUserAssignments", fields: [teacherUserId], references: [id], onDelete: Cascade)
  classroom     Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  discipline    Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([teacherUserId, classroomId, disciplineId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
